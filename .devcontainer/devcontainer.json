{
  "name": "@excellence-wh/cz",
  "build": {
    "dockerfile": "../deploy/devcontainer/Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": ["biomejs.biome", "golang.go", "EditorConfig.EditorConfig"],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "biomejs.biome",
        "editor.codeActionsOnSave": {
          "source.fixAll.biome": "explicit"
        },
        "typescript.tsdk": "node_modules/typescript/lib",
        "files.eol": "\n"
      }
    }
  },
  "postCreateCommand": "pnpm install",
  "remoteUser": "vscode"
}
