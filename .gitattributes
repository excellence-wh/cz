# 统一换行符：仓库内存 LF，避免 Windows 下 CRLF 污染 diff
# 注意：eol=lf 的优先级高于 core.autocrlf（你机器上 autocrlf=true，这里会覆盖它）
* text=auto eol=lf

# Windows 专用脚本必须 CRLF，否则 cmd 解析异常
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell 脚本强制 LF，否则 git-bash / CI 里会报 `\r: command not found`
*.sh text eol=lf

# 二进制文件，禁止任何换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.docx binary
*.xlsx binary
*.pptx binary

# 锁文件：GitHub 上折叠显示，不参与语言统计
pnpm-lock.yaml linguist-generated=true

# 后续产物不入语言统计
dist/** linguist-generated=true
